def Scope "Instances"
{
    def Xform "obj_visual" (
        prepend references = @./geometries.usd@</Geometries/obj_visual>
    )
    {
        over "obj_visual" (
            apiSchemas = ["MaterialBindingAPI"]
        )
        {
            custom rel material:binding
            prepend rel material:binding = </Instances/obj_visual/VisualMaterials/steel>
            custom string urdf:name = "obj_visual"
        }

        def Scope "VisualMaterials"
        {
            def Material "steel" (
                instanceable = true
                prepend references = @./materials.usda@</Materials/steel>
            )
            {
            }
        }
    }
}

